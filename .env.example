PORT=3000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
DATABASE_URL=YOUR_DATABASE_URL_HERE

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Omise (Dashboard -> Keys) — ใช้คู่ key ของโหมด live หรือ test ก็ได้ตามต้องการ แต่ต้องมาจากโหมดเดียวกันทั้งคู่
# ต้องใส่ทั้งสองตัว — SDK ของ Omise ใช้ secret key กับ charges/account แต่ omise.sources.create()
# (สร้าง QR PromptPay) ถูก hardcode ให้ auth ด้วย public key เท่านั้น ถ้าใส่แค่ secret key
# resource อื่นจะทำงานปกติ (ทำให้เข้าใจผิดว่าคีย์ถูกต้อง) แต่สร้าง QR ไม่ได้เลย
OMISE_SECRET_KEY=YOUR_OMISE_SECRET_KEY
OMISE_PUBLIC_KEY=YOUR_OMISE_PUBLIC_KEY

# อีเมลแอดมินที่เข้าหน้า /api/admin/* ได้ (คั่นด้วย comma ถ้ามีหลายคน) — ต้องเป็นอีเมลที่สมัครสมาชิกไว้แล้ว
ADMIN_EMAILS=you@example.com

# ส่งอีเมลแจ้งเตือนเมื่อมีคำร้อง/แจ้งปัญหาใหม่เข้ามา (ไม่ตั้งก็ได้ — ถ้าไม่ตั้งจะแค่ข้ามการส่งอีเมล
# คำร้องยังบันทึกลง Supabase ตามปกติ) ส่งผ่าน Resend (HTTPS API พอร์ต 443 ไม่ใช่ SMTP ตรง — SMTP ตรงไป
# Gmail มักโดนบล็อก/ไม่เสถียรจาก cloud host อย่าง Render) สมัครฟรีที่ https://resend.com (3,000 ฉบับ/
# เดือน) แล้วสร้าง API key จาก Dashboard -> API Keys — SUPPORT_EMAIL_USER คืออีเมลปลายทางที่จะรับการแจ้งเตือน
#
# สำคัญ: ถ้ายังไม่ได้ verify domain ของตัวเองกับ Resend (resend.com/domains) จะอยู่ในโหมด sandbox ซึ่ง
# Resend อนุญาตให้ส่งได้เฉพาะไปหา "อีเมลที่ใช้สมัครบัญชี Resend" เท่านั้น (ส่งไปอีเมลอื่นจะได้ 403
# validation_error) เลยต้องตั้ง SUPPORT_EMAIL_USER เป็นอีเมลเดียวกับที่สมัคร Resend ไว้ก่อน — ถ้าอยากส่ง
# ไปอีเมลอื่นได้อิสระ (เช่น admin@โดเมนของตัวเอง) ต้อง verify domain ที่ resend.com/domains ก่อน
RESEND_API_KEY=YOUR_RESEND_API_KEY
SUPPORT_EMAIL_USER=YOUR_RESEND_ACCOUNT_EMAIL