PORT=3000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
DATABASE_URL=YOUR_DATABASE_URL_HERE

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Omise (Dashboard -> Keys) — ใช้คู่ key ของโหมด live หรือ test ก็ได้ตามต้องการ แต่ต้องมาจากโหมดเดียวกันทั้งคู่
# ต้องใส่ทั้งสองตัว — SDK ของ Omise ใช้ secret key กับ charges/account แต่ omise.sources.create()
# (สร้าง QR PromptPay) ถูก hardcode ให้ auth ด้วย public key เท่านั้น ถ้าใส่แค่ secret key
# resource อื่นจะทำงานปกติ (ทำให้เข้าใจผิดว่าคีย์ถูกต้อง) แต่สร้าง QR ไม่ได้เลย
OMISE_SECRET_KEY=YOUR_OMISE_SECRET_KEY
OMISE_PUBLIC_KEY=YOUR_OMISE_PUBLIC_KEY

# อีเมลแอดมินที่เข้าหน้า /api/admin/* ได้ (คั่นด้วย comma ถ้ามีหลายคน) — ต้องเป็นอีเมลที่สมัครสมาชิกไว้แล้ว
ADMIN_EMAILS=you@example.com

# ส่งอีเมลแจ้งเตือนเมื่อมีคำร้อง/แจ้งปัญหาใหม่เข้ามา (ไม่ตั้งก็ได้ — ถ้าไม่ตั้งจะแค่ข้ามการส่งอีเมล
# คำร้องยังบันทึกลง Supabase ตามปกติ) ใช้ Gmail SMTP ธรรมดา ต้องเป็น "App Password" ไม่ใช่รหัสผ่านจริง
# ของบัญชี — สร้างได้ที่ https://myaccount.google.com/apppasswords (ต้องเปิด 2-Step Verification ก่อน)
# ส่งจาก/ส่งไปที่อีเมลเดียวกันนี้ (แจ้งเตือนตัวเอง)
SUPPORT_EMAIL_USER=admin.aceoftarot@gmail.com
SUPPORT_EMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD